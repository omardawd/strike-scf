# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=https://app.strikescf.com
NEXT_PUBLIC_DEV_BANK_ID=your-bank-uuid
CRON_SECRET=your-cron-secret   # gates all Vercel cron routes, incl. /api/agents/tick, via x-cron-secret header
REQUIRE_MANUAL_KYB_APPROVAL=true   # soft-launch guardrail: AI still scores + recommends, but a Strike Admin must click Approve in the KYB queue even at score >=60. Set to false (or unset) once comfortable with full auto-approval.
DEMO_ROUTES_ENABLED=false   # server-only kill switch for /api/demo/*; every demo route 404s unless this is exactly "true". Leave unset/false in real production.
DISABLE_AUTH=false   # TEMPORARY dev-only toggle: when exactly "true", middleware.ts silently signs in every unauthenticated visitor as jfurner@walmart.com (DevPass123!) and /login+/signup redirect to /home. Anyone with the URL gets full account control. Never leave this "true" in real production — unset it (or set to false) and redeploy the moment you're done.
INTERNAL_SECRET=your-internal-service-secret   # gates internal service-to-service calls (e.g. /api/passport/recalculate via x-strike-internal header) — was previously used but undocumented here

# AI
ANTHROPIC_API_KEY=your-anthropic-api-key
TAVILY_API_KEY=tvly-your-tavily-key   # web search for Strike AI — free tier: tavily.com
EXA_API_KEY=your-exa-api-key   # semantic/niche discovery search for Strike Sourcing — exa.ai
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key   # deep page/PDF extraction for Strike Sourcing — firecrawl.dev

# Email (Resend)
RESEND_API_KEY=your-resend-api-key

# Rate limiting (Upstash Redis — optional; falls back to an in-memory limiter,
# which is NOT safe as the sole control across multiple serverless instances)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Error tracking (optional; lib/error-tracking.ts stays a local-log-only no-op
# until this is set — no external calls are ever made without it)
ERROR_TRACKING_DSN=

# /api/ai/dispatch CORS — comma-separated list of allowed origins for
# browser-based callers. Leave unset unless a genuine cross-origin browser
# client is added (native apps and server-to-server webhooks need no CORS).
DISPATCH_ALLOWED_ORIGINS=
